# Configuración del Proxy del Asistente de IA de Bolsillo Claro
# Copia este archivo como .env y coloca tu clave gratuita de Google AI Studio.
# NUNCA subas el archivo .env ni expongas tu clave secreta.

# Clave de API de Google Gemini (Obtén una gratis en https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Identificador de modelo Gemini (por defecto gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Puerto del proxy (por defecto 3000)
PORT=3000
